# Export these in your process environment. Never commit a real secret.
DATABASE_URL=postgresql://localhost:5432/ibpm
AUTH_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:5173
MARKET_BACKEND=database
PORT=3001
# Frontend defaults: PORT=5173 BASE_PATH=/ API_URL=http://127.0.0.1:3001
# After the frontend chain adapter/indexer is connected, use MARKET_BACKEND=solana.
# SOLANA_PROGRAM_ID must match the deployed binary and checked-in IDL.
